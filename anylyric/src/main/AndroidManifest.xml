<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限只有四项，各自都有明确用途：
      · SYSTEM_ALERT_WINDOW —— 悬浮窗本体；
      · 通知使用权 —— service 上的 BIND 权限，在系统「通知使用权」列表里授权，不是 uses-permission；
      · INTERNET —— **只用于应用内更新**（读公共仓库的 latest.json、下载安装包）。
        歌词仍然不联网、不读本地文件，这是产品一期就定死的边界；
      · REQUEST_INSTALL_PACKAGES —— 下载完新版本后拉起系统安装器。
      不申请存储、无障碍、蓝牙、读取日志等任何其它权限。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      两项自启相关（0.2.7，用户拍板放开旧的「不申请电池白名单」边界）：
      · RECEIVE_BOOT_COMPLETED —— 收开机广播，配合设置里的「开机自启」开关主动
        requestRebind（不少车机重启后迟迟不绑通知使用权）；
      · REQUEST_IGNORE_BATTERY_OPTIMIZATIONS —— 「后台保活」开关弹系统白名单弹窗。
        都是用户在设置里主动打开才生效，默认零打扰。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11+ 的包可见性：不声明这些 action，resolveActivity()/queryIntentActivities()
      对系统设置页一律返回 null，连「到底有没有这个页面」都判断不出来。
      只声明需要用到的几个，不申请宽泛可见性。
    -->
    <queries>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyLyric">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DiagActivity"
            android:exported="false"
            android:label="@string/diag_title" />

        <!--
          给系统安装器发安装包 URI。exported=false + grantUriPermissions=true：
          只有本应用显式授权的那个 URI 可读，目录内其它文件不暴露。
          authorities 用 ${applicationId} 而不是写死 —— debug 包带 .debug 后缀，
          写死会和正式包撞车，导致第二个包装不上。
        -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="${applicationId}.apkfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          exported 必须为 true 且带 BIND_NOTIFICATION_LISTENER_SERVICE 权限：
          系统（而非第三方应用）用它来绑定本服务，用户授权后才生效。
          Android 12 起 exported 必须显式声明，故此处写明。
        -->
        <service
            android:name=".service.MediaWatchService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          exported 必须是 true：BOOT_COMPLETED 的发送方是系统进程，
          写成 false 时系统广播根本不会送达，表现就是「开关打开了但开机没反应」。
          （这条经验来自 WindTone 车机真机。）
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
