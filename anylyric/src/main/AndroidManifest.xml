<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限只有四项，各自都有明确用途：
      · SYSTEM_ALERT_WINDOW —— 悬浮窗本体；
      · 通知使用权 —— service 上的 BIND 权限，在系统「通知使用权」列表里授权，不是 uses-permission；
      · INTERNET —— 两个用途：
          ① 应用内更新（读公共仓库 latest.json、下载安装包）；
          ② 本地取不到词时按**歌名 + 歌手**在线补词（0.2.23 起默认开启，设置里可关）。
             只发这两个字段，取到即落盘，同一首歌之后不再联网；
      · REQUEST_INSTALL_PACKAGES —— 下载完新版本后拉起系统安装器。
      不申请存储、蓝牙、读取日志等任何其它权限。

      唯一的例外是 ACCESS_NETWORK_STATE（0.2.23）：普通权限，安装即授予、不弹窗，
      只用来注册「默认网络恢复可用」的回调 —— 车机开机时常常还没联网，等网通了要把
      在线补词的失败次数清零重试，否则那一首永远停在「暂无歌词」。

      0.2.11 起多了一个**无障碍服务**（.accessibility.ForegroundAppService），但它不是
      uses-permission、也不是默认生效的：只有用户主动去系统「辅助功能」里打开后，
      「按应用隐藏悬浮窗」才会工作；关闭时该服务根本不会被系统绑定。
      订阅面只有「窗口切换」与「媒体通知」两类事件，canRetrieveWindowContent=false ——
      读不到屏幕内容。媒体通知这条是 0.2.22 加的：车厂把通知使用权授权页整页拦掉时，
      媒体通知里的歌名是唯一还能拿到的信息（见 res/xml/foreground_app_service.xml 的说明），
      且**只处理 category=transport / 带 EXTRA_MEDIA_SESSION 的通知**，其余一个字段都不读。
      这是与 WindTone 同款的实现取舍，写在这里是为了不让下一个人误以为它是白捡的。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      仅用于 ConnectivityManager.registerDefaultNetworkCallback（0.2.23）。
      普通权限：不弹窗、不给用户添任何一步操作，也读不到网络内容。
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      两项自启相关（0.2.7，用户拍板放开旧的「不申请电池白名单」边界）：
      · RECEIVE_BOOT_COMPLETED —— 收开机广播，配合设置里的「开机自启」开关主动
        requestRebind（不少车机重启后迟迟不绑通知使用权）；
      · REQUEST_IGNORE_BATTERY_OPTIMIZATIONS —— 「后台保活」开关弹系统白名单弹窗。
        都是用户在设置里主动打开才生效，默认零打扰。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      仅声明、默认不授予（signature 级，普通安装拿不到，adb `pm grant` 才能给）。
      唯一用途：HONOR/MagicOS 在应用更新后会把无障碍服务关掉，有它才能自动写回。
      没有它时功能完全不受影响，只是变成「引导用户手动重开」。声明在这里是为了让
      愿意用 adb 的用户有一条自动恢复的路，而不是每次升级都要手动补。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Android 11+ 的包可见性：不声明这些 action，resolveActivity()/queryIntentActivities()
      对系统设置页一律返回 null，连「到底有没有这个页面」都判断不出来。
      只声明需要用到的几个，不申请宽泛可见性。
    -->
    <queries>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <!-- 无障碍设置页：不声明时 resolveActivity() 恒为 null，「去开启」按钮点了没反应。 -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" />
        </intent>
        <!-- 应用选择器要枚举「有桌面入口的应用」。Android 11+ 不声明时
             queryIntentActivities 只返回本应用自己的那一两个，列表会空得像坏了。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- BYD 第三方媒体控制 SDK：不声明包可见性时 resolveService 恒为 null，
             连「这台车机上有没有这个服务」都判断不出来。 -->
        <package android:name="com.byd.mediacontroller" />
        <intent>
            <action android:name="com.byd.mediacontroller.thirdapp.controller" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyLyric">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DiagActivity"
            android:exported="false"
            android:label="@string/diag_title" />

        <!--
          给系统安装器发安装包 URI。exported=false + grantUriPermissions=true：
          只有本应用显式授权的那个 URI 可读，目录内其它文件不暴露。
          authorities 用 ${applicationId} 而不是写死 —— debug 包带 .debug 后缀，
          写死会和正式包撞车，导致第二个包装不上。
        -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="${applicationId}.apkfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          exported 必须为 true 且带 BIND_NOTIFICATION_LISTENER_SERVICE 权限：
          系统（而非第三方应用）用它来绑定本服务，用户授权后才生效。
          Android 12 起 exported 必须显式声明，故此处写明。
        -->
        <service
            android:name=".service.MediaWatchService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          exported 必须是 true：BOOT_COMPLETED 的发送方是系统进程，
          写成 false 时系统广播根本不会送达，表现就是「开关打开了但开机没反应」。
          （这条经验来自 WindTone 车机真机。）
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          静默掉线看门狗：默认关闭，用户在「开机与后台」里打开后由 JobScheduler
          每 15 分钟唤醒一次，心跳过期才 requestRebind。不常驻、不持锁。
          BIND_JOB_SERVICE 是系统绑定 JobService 所需的权限。
        -->
        <service
            android:name=".service.WatchdogJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          前台应用检测（0.2.11，「按应用隐藏悬浮窗」）：只在用户主动去系统
          「辅助功能」里开启后才工作。订阅面见 res/xml/foreground_app_service.xml，
          只收窗口切换事件、canRetrieveWindowContent=false（读不到屏幕内容）。
          BIND_ACCESSIBILITY_SERVICE 是系统绑定所必需，写错会绑不上。
        -->
        <service
            android:name=".accessibility.ForegroundAppService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/foreground_app_service" />
        </service>
    </application>
</manifest>
