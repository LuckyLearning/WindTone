<?xml version="1.0" encoding="utf-8"?>
<!--
    DiLink 7 分屏声明（0.2.29）的默认值。

    分屏框架会读 <meta-data android:name="BYD_SUPPORT_SPLIT_ACTIVITY"> 的值，
    非 0 才允许把本应用放进 3/7 / 7 分屏的格子里。API 32 以下框架不认这套，
    给 0 与「不支持」的语义一致，也避免旧车上出现半生效的状态。
    API 32+ 的值见 values-v32/integers.xml。
-->
<resources>
    <integer name="byd_support_split_activity">0</integer>
</resources>
