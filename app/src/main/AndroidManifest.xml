<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取本地音频（Android 13+ 细分权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 可选：深度扫描（读取同目录 .lrc 歌词文件） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      均衡器与音效：`AudioEffect`（Equalizer / BassBoost / Virtualizer / PresetReverb）
      在部分 ROM（尤其车机）上要求调用方持有该权限，否则构造即抛异常，
      表现为「明明在播放，音效页却说不可用」。这是普通权限，安装即授予、不弹窗。
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      G7 蓝牙自动车机：列出已配对/已连接蓝牙名以便「记住的设备」。
      仅开「任意蓝牙音频」时可不授此权——AudioDeviceCallback 仍能感知 A2DP 路由。
      Android 12+ 运行时申请；老系统 BLUETOOTH 为普通权限。
    -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      桌面悬浮歌词：在车机桌面 / 导航页最上层挂一行歌词字幕。
      默认关闭，需要用户在系统设置里手动授予「出现在其他应用上」才会生效
      （比亚迪 DiLink 车机路径：设置 → 应用 → 权限 → 出现在其他应用上）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      应用内更新：仅用于向 GitHub Releases 查询新版本、下载 APK。
      除此之外不发任何请求，不采集任何数据（详见 README「权限说明」）。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 8.0+ 从应用内拉起安装器需要此权限，用户仍会在系统弹窗中二次确认 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      车载模式开机自启：车机（或手机）开机完成后自动拉起主界面进入播放页。
      只在设置里开启了「车载模式」时才动作；不开启时收到开机广播什么都不做。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v1.1.83：申请「忽略电池优化」白名单（车机息屏后会冻结后台轮询；
         这是「按应用隐藏」在车机上活过夜晚的前提，不需要 adb） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      语音识别可见性（Android 11+ 的包可见性）：不声明的话，判断「本机有没有语音识别
      服务」一律返回 null，麦克风入口会永远走兜底。语音听写只用于搜索框，不上传音频。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".MusicApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:hardwareAccelerated="${hwAccel}"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MusicPlayer">

        <!--
          Android Auto：声明本应用提供「媒体」能力。
          没有这份描述，Android Auto 不会把应用列进车机的媒体面板，
          浏览树再完整也没人看（车机自带的 DiLink 面板不走这条，靠上面的 service action 发现）。

          早先这里挂过 `tools:ignore="MissingIntentFilterForMediaSearch"`：当时浏览树只做歌单
          层级、不含搜索，声明 `MEDIA_PLAY_FROM_SEARCH` 等于交一个空实现。2026-10-27 起
          曲库搜索已具备（文本 / 全拼 / 首字母），该 action 已在 MainActivity 上真正声明并有实现，
          这条 lint 不再需要忽略 —— 忽略反而会掩盖以后别处漏声明的情况。
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MusicPlayer"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              ②「我是音乐播放器」——车机把本应用列进「默认音乐」候选的依据（2026-10-27）。

              比亚迪 DiLink（以及多数国产车机）判定「谁是音乐应用」没有统一标准，实测可查的
              三条依据我们**全部**声明，命中哪条都能被列进去：
                · `CATEGORY_APP_MUSIC`：桌面/启动器的「音乐」分类，部分车机直接读这个；
                · `ACTION_VIEW` + `audio/*`：文件管理器里点一首歌的「用什么打开」，
                  车机常把这份解析结果当成音乐应用清单；
                · `MEDIA_PLAY_FROM_SEARCH`：系统语音「播放周杰伦」的入口（见下一条）。
              声明了就必须真的能处理，否则点进来是空的 —— 处理逻辑在 `ui/ExternalMedia.kt`，
              由 `MainScreen` 消费（曲库就绪后才动作，不抢冷启动）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              `tools:ignore="AppLinkUrlError"`：lint 看到 `ACTION_VIEW` 就要求给一个
              scheme + host（它以为这是 App Link 声明）。这里要的只是「文件管理器点开音频时
              能选到本应用」，匹配靠 **mimeType**，URI 由系统用 content: / file: 传进来 ——
              补一个假域名反而是错的（会把 http 链接也劫到本应用上）。
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>

            <!--
              系统级语音点歌：`MEDIA_PLAY_FROM_SEARCH`。
              以前刻意不声明（lint 的 `MissingIntentFilterForMediaSearch` 就指着这条），
              理由是「浏览树不含搜索，声明了等于一个空实现」。现在曲库搜索已经具备
              （`data/LibrarySearch.kt`：文本 / 全拼 / 首字母三路），这个入口终于有真东西可交：
              小迪只要把查询词塞进 `SearchManager.QUERY`，我们就能把第一首命中的播起来。
              ⚠️ 这条能否真的被小迪调用取决于车机是否把本应用设为「默认音乐」——
              那一步在系统设置里，应用无法自己完成。
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              桌面长按快捷方式的落点（2026-10-17 修「点击提示未安装应用」）。

              `res/xml/shortcuts.xml` 里那三个 <intent> **只有 action、没有组件**，
              必须靠这条 intent-filter 才能解析到本 Activity：
                · 快捷方式的 intent 如果只写 targetClass 不写 targetPackage，
                  所有 ROM 上点击都提示「未安装应用」（v1.1.3 ~ v1.1.11 的实际表现）；
                  两个都写则把包名写死，debug 的 `.debug` 后缀包会被拉到正式版去。
                  （模拟器实测：旧写法 + 无这条 filter 时
                   `cmd package resolve-activity -a <action>` 直接回 "No activity found"）
                · 隐式意图要求目标 intent-filter 含 `CATEGORY_DEFAULT`（startActivity 的
                  额外要求），少了这一条同样解析不到。
              action 字符串是固定的常量（与 `AppShortcut.ACTION` 逐字一致），
              故意不跟着 applicationId 变 —— 它与包名无关，改了两边都得改。

              小组件（MusicWidgetProvider）与磁贴（PlaybackTileService）走的是
              显式 Intent，不依赖这条 filter，只是复用同一个 action / extra 通道。
            -->
            <intent-filter>
                <action android:name="com.luckylearning.windtone.SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              桌面长按图标 → 播放全部 / 随机播放 / 我的收藏（批次 9.4）。
              intent 的 action / extra 定义见 res/xml/shortcuts.xml，
              解析在 AppShortcut.kt，三处的字符串必须逐字一致
              （契约由 AppShortcutContractTest 守着）。
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          播放服务。三个 action 是**并列**的，不是一个里塞三个：
            · MediaLibraryService —— 车机 / 外部浏览器（Android Auto、车机自带媒体面板）
              通过它拿到浏览树（歌单层级），见 playback/LibraryBrowser.kt；
            · MediaSessionService —— 本应用自己的 MediaController 通过它连接
              （实际按组件名 SessionToken 建连，不依赖这个 action，留着是为了兼容
               仍按 action 枚举媒体应用的旧实现）；
            · MediaBrowserService —— Android Auto / 车机系统媒体面板的发现入口。
          MediaLibraryService 是 MediaSessionService 的子类，前两者共存不冲突。
        -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          媒体按键接收器（2026-10-27）：方向盘 / 蓝牙耳机 / 车机方控按下播放键时，
          系统会把 `MEDIA_BUTTON` 广播发给「当前媒体应用」。没有这个接收器时，
          有些 ROM 干脆不把本应用算作媒体应用 —— 这也是「默认音乐」列表里看不到它的原因之一。
          media3 的实现会自己找回已声明的 MediaSessionService 并把按键转成会话命令。
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          悬浮歌词服务：承载桌面最上层那一行歌词。
          exported="false"——只由本应用自己起停，不对外暴露。
          目标车机（比亚迪宋 L DM-i 26 款，DiLink 100 / Android 12）用
          mediaPlayback 类型即可，无需 Android 14 才有的 specialUse。
        -->
        <service
            android:name=".overlay.LyricOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.luckylearning.windtone.widget.TOGGLE" />
                <action android:name="com.luckylearning.windtone.widget.NEXT" />
                <action android:name="com.luckylearning.windtone.widget.PREVIOUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!--
          车载模式开机自启。BOOT_COMPLETED / QUICKBOOT_POWERON（部分车机在用
          这类厂商广播表示「上电完成」）。内部会再检查一次车载模式开关，
          关着就静默返回——手机用户不会被打扰。
        -->
        <!-- exported 必须是 true：BOOT_COMPLETED 的发送方是系统进程，
             写成 false 时系统广播根本不会送达，表现就是「开关打开了但开机没反应」。 -->
        <receiver
            android:name=".CarBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.PlaybackTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_play"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          「下一首」磁贴（批次 9.5-②）。一个 TileService 只承载一个点击动作，
          所以它必须独立成服务；用户想加就加，不想要就不加。
        -->
        <service
            android:name=".tile.NextTrackTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_next"
            android:label="@string/tile_next"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          「收藏当前曲」磁贴（H1）。与播放/暂停、下一首同理：一颗磁贴一个动作。
          无当前曲或无法识别身份时置灰；已收藏为 ACTIVE。落盘见 FavoriteToggle。
        -->
        <service
            android:name=".tile.FavoriteTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_favorite"
            android:label="@string/tile_favorite"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          前台应用检测（v1.1.29「悬浮窗按应用隐藏」，设计见 docs/设计-悬浮窗按应用隐藏.md）。

          用户在系统设置 → 辅助功能里手动开启后，本服务才知道「当前前台是哪个应用」，
          好在 360 影像等应用打开时收起悬浮歌词、并按开关记录前台切换历史。
          · `BIND_ACCESSIBILITY_SERVICE` 是系统绑定用的签名权限，必须声明，
            否则服务根本不会被辅助功能列表接纳；
          · 订阅面见 res/xml/foreground_app_service.xml —— 只收窗口状态变化、
            **不读屏幕内容**；
          · 不授权也能用：检测通道一个都没通时按「不隐藏」放行（见 ForegroundAppState）。
        -->
        <!-- v1.1.83：exported 必须为 true —— 绑定方是 system_server（跨进程），
             false 时即使写进 ENABLED_ACCESSIBILITY_SERVICES 也不会生效。
             权限仍是 signature 级 BIND_ACCESSIBILITY_SERVICE，只有系统能绑。 -->
        <service
            android:name=".overlay.ForegroundAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/foreground_app_service" />
        </service>

        <!--
          应用内更新下载的 APK 放在 cacheDir/updates/，通过 FileProvider 交给系统安装器。
          以 ${applicationId} 作为 authority，保证 debug（.debug 后缀）与 release 互不冲突。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
